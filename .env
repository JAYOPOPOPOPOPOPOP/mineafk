# ======================
# MineAFK Cloud - Environment Variables
# Copy to .env and fill values. NEVER commit real secrets.
# Railway: Set these in the Railway dashboard per service.
# ======================

# ----- Database (Railway PostgreSQL plugin) -----
DATABASE_URL="postgresql://postgres:password@localhost:5432/mineafk?schema=public"

# ----- Redis (Railway Redis plugin) -----
REDIS_URL="redis://localhost:6379"

# ----- App -----
NODE_ENV="development"
PORT=3001
WEB_URL="http://localhost:3000"
API_URL="http://localhost:3001"
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
ENCRYPTION_KEY="32-byte-hex-or-base64-key-for-token-encryption-change-me"

# ----- Auth -----
# Optional: Microsoft OAuth (for Premium accounts)
# Create app at https://portal.azure.com → App registrations
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3001/api/auth/microsoft/callback"
MICROSOFT_TENANT="consumers"

# ----- Email (optional - for verification / notifications) -----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@mineafk.cloud"

# ----- Worker -----
WORKER_CONCURRENCY=2
MAX_BOTS_PER_USER=2
MAX_CONCURRENT_BOTS=3
BOT_MEMORY_LIMIT_MB=256

# ----- Security -----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN="http://localhost:3000"

# ----- Admin bootstrap (one-time only) -----
# Run: npm run create-superadmin -- --email=you@example.com --password=StrongPass123!
SUPERADMIN_BOOTSTRAP_SECRET="one-time-secret-for-first-admin-setup"

# ----- Feature flags -----
ENABLE_OFFLINE_ACCOUNTS=true
ENABLE_PREMIUM_ACCOUNTS=true
ENABLE_SCHEDULES=true
ENABLE_ANALYTICS=true
